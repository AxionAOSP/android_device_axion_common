# vendor sysfs access for device-specific hwmon/power/gpu nodes
allow ax_diagnostics vendor_sysfs_battery_supply:dir r_dir_perms;
allow ax_diagnostics vendor_sysfs_battery_supply:file r_file_perms;
allow ax_diagnostics vendor_sysfs_devfreq:dir r_dir_perms;
allow ax_diagnostics vendor_sysfs_devfreq:file r_file_perms;
allow ax_diagnostics vendor_sysfs_graphics:dir r_dir_perms;
allow ax_diagnostics vendor_sysfs_graphics:file r_file_perms;
allow ax_diagnostics vendor_sysfs_kgsl:dir r_dir_perms;
allow ax_diagnostics vendor_sysfs_kgsl:file r_file_perms;
allow ax_diagnostics vendor_sysfs_kgsl:lnk_file read;
allow ax_diagnostics vendor_sysfs_kgsl_gpuclk:file r_file_perms;

allow ax_diagnostics sysfs_battery_supply:dir r_dir_perms;
allow ax_diagnostics sysfs_battery_supply:file r_file_perms;
allow ax_diagnostics sysfs_devfreq:dir r_dir_perms;
allow ax_diagnostics sysfs_devfreq:file r_file_perms;
allow ax_diagnostics sysfs_graphics:dir r_dir_perms;
allow ax_diagnostics sysfs_graphics:file r_file_perms;
allow ax_diagnostics sysfs_kgsl:dir r_dir_perms;
allow ax_diagnostics sysfs_kgsl:file r_file_perms;
allow ax_diagnostics sysfs_kgsl:lnk_file read;
