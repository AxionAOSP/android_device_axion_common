  Kernel Manager configuration

  Device: OnePlus Nord (avicii)
  SoC: Qualcomm Snapdragon 765G 5G (lito)
-->
<kernel-manager>
    <cpu
        id="little"
        group="Silver • Core 0-5"
        minId="axion_min_freq"
        maxId="axion_max_freq"
        governorId="little_cpu_governor"
        minNode="/sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq"
        maxNode="/sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq"
        availablePath="/sys/devices/system/cpu/cpufreq/policy0/scaling_available_frequencies"
        governorNode="/sys/devices/system/cpu/cpufreq/policy0/scaling_governor"
        governorAvailablePath="/sys/devices/system/cpu/cpufreq/policy0/scaling_available_governors" />

    <cpu
        id="big"
        group="Gold • Core 6"
        minId="axion_min_freq_big"
        maxId="axion_max_freq_big"
        governorId="big_cpu_governor"
        minNode="/sys/devices/system/cpu/cpufreq/policy6/scaling_min_freq"
        maxNode="/sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq"
        availablePath="/sys/devices/system/cpu/cpufreq/policy6/scaling_available_frequencies"
        governorNode="/sys/devices/system/cpu/cpufreq/policy6/scaling_governor"
        governorAvailablePath="/sys/devices/system/cpu/cpufreq/policy6/scaling_available_governors" />

    <cpu
        id="prime"
        group="Prime • Core 7"
        minId="axion_min_freq_prime"
        maxId="axion_max_freq_prime"
        governorId="prime_cpu_governor"
        minNode="/sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq"
        maxNode="/sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq"
        availablePath="/sys/devices/system/cpu/cpufreq/policy7/scaling_available_frequencies"
        governorNode="/sys/devices/system/cpu/cpufreq/policy7/scaling_governor"
        governorAvailablePath="/sys/devices/system/cpu/cpufreq/policy7/scaling_available_governors" />

    <gpu
        node="/sys/class/kgsl/kgsl-3d0/devfreq"
        currentNode="/sys/class/kgsl/kgsl-3d0/gpuclk"
        usageNode="/sys/class/kgsl/kgsl-3d0/gpu_busy_percentage"
        availablePath="/sys/class/kgsl/kgsl-3d0/devfreq/available_frequencies"
        frequencyMultiplier="1"
        values="625000000,500000000,400000000,275000000" />
</kernel-manager>
