<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-FileCopyrightText: AxionOS
  SPDX-License-Identifier: Apache-2.0

  Performance/Thermal configuration - Snapdragon 7s Gen 2 (SM7435)
  Target Device: garnet

  CPU topology:
  - policy0: CPU[0-3] (Little, Cortex-A55)
  - policy4: CPU[4-7] (Big, Cortex-A78)

  CPU ladder (MHz):
  - Little: 1958, 1805, 1651, 1497, 1324, 1113, 940, 806, 691
  - Big:    2400, 2304, 2208, 2112, 2054, 1900, 1651, 1497, 1344, 1190, 960, 691

  GPU ladder (MHz):
  - Adreno 710: 940, 875, 816, 734, 650, 600, 500, 345, 295
-->

<perf-config>
    <atmc>
        <!-- CPU Frequency Ladder -->
        <cpu_levels>
            <level id="1"  little="0,1958" big="0,2400"/>
            <level id="2"  little="0,1805" big="0,2304"/>
            <level id="3"  little="0,1651" big="0,2208"/>
            <level id="4"  little="0,1497" big="0,2112"/>
            <level id="5"  little="0,1324" big="0,2054"/>
            <level id="6"  little="0,1113" big="0,1900"/>
            <level id="7"  little="0,940"  big="0,1651"/>
            <level id="8"  little="0,806"  big="0,1497"/>
            <level id="9"  little="0,691"  big="0,1344"/>
            <level id="10" little="0,691"  big="0,1190"/>
            <level id="11" little="0,691"  big="0,960"/>
            <level id="12" little="0,691"  big="0,691"/>
        </cpu_levels>

        <!-- GPU Frequency Ladder (clocks in MHz) -->
        <gpu_levels>
            <level id="1" min="940" max="940"/>
            <level id="2" min="875" max="875"/>
            <level id="3" min="816" max="816"/>
            <level id="4" min="734" max="734"/>
            <level id="5" min="650" max="650"/>
            <level id="6" min="600" max="600"/>
            <level id="7" min="500" max="500"/>
            <level id="8" min="345" max="345"/>
            <level id="9" min="295" max="295"/>
        </gpu_levels>

        <!-- Base Profiles / Scenes -->
        <scenes>
            <scene name="default_scene">
                <level id="5">
                    <action unit="cpu" status="3"/>
                </level>
                <level id="8">
                    <action unit="cpu" status="4"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="5"/>
                    <action unit="dexopt" status="1"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="6"/>
                    <action unit="bg_killer" status="3"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="7"/>
                    <action unit="bg_killer" status="4"/>
                </level>
                <level id="12">
                    <action unit="cpu" status="7"/>
                </level>
                <level id="13">
                    <action unit="cpu" status="8"/>
                </level>
            </scene>
        </scenes>

        <!-- App Specific Thermal Profiles -->
        <apps>
            <!-- Navigation apps: Tuned to prevent dashboard overheating under direct sun -->
            <app pkgs="com.google.android.apps.maps,com.autonavi.minimap,com.baidu.BaiduMap,org.microg.tools.selfupdate">
                <level id="7">
                    <action unit="cpu" status="6"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="9"/>
                </level>
            </app>

            <!-- Heavy Games (Genshin, PUBG, etc.): Tuned for sustained thermal stability over burst spikes -->
            <app pkgs="com.tencent.tmgp.pubgmhd,com.epicgames.fortnite,com.miHoYo.GenshinImpact,com.miHoYo.hkrpg,com.mojang.minecraftpe,com.HoYoverse.hkrpgoversea,com.miHoYo.Yuanshen,com.pubg.imobile,com.activision.callofduty.shooter,com.dts.freefireth,com.dts.freefiremax">
                <level id="5">
                    <action unit="cpu" status="4"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="6"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="8"/>
                </level>
            </app>
        </apps>
    </atmc>
</perf-config>
