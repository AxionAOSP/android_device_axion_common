  Performance/Thermal configuration - Qualcomm Snapdragon 765G 5G (lito)
  Author: Sreeshankar K <sreeshankar0910@gmail.com>

  CPU:
  +-------------------------------------------------------------------+
  | Core | Cluster | OPP (MHz)                                        |
  |------|---------|--------------------------------------------------|
  | 0-5  | Silver  | 300, 576, 614, 864, 1075, 1363, 1516, 1651, 1804 |
  |------|---------|--------------------------------------------------|
  | 6    | Gold    | 652, 940, 1152, 1478, 1728, 1900, 2092, 2208     |
  |------|---------|--------------------------------------------------|
  | 7    | Prime   | 806, 1094, 1401, 1766, 1996, 2188, 2304, 2400    |
  +-------------------------------------------------------------------+
  
  GPU:
  +---------------------------------+
  | Model      | OPP (MHz)          |
  |---------------------------------| 
  | Adreno 620 | 275, 400, 500, 625 |
  +---------------------------------+
-->

<perf-config>
    <atmc>
        <!-- CPU Frequency Ladder -->
        <cpu_levels>
            <level id="1"  little="0,1804" big="0,2208" prime="0,2400"/>
            <level id="2"  little="0,1804" big="0,2208" prime="0,2304"/>
            <level id="3"  little="0,1804" big="0,2092" prime="0,2304"/>
            <level id="4"  little="0,1804" big="0,2092" prime="0,2188"/>
            <level id="5"  little="0,1651" big="0,2092" prime="0,2188"/>
            <level id="6"  little="0,1651" big="0,1900" prime="0,2188"/>
            <level id="7"  little="0,1651" big="0,1900" prime="0,1996"/>
            <level id="8"  little="0,1516" big="0,1900" prime="0,1996"/>
            <level id="9"  little="0,1516" big="0,1728" prime="0,1996"/>
            <level id="10" little="0,1516" big="0,1728" prime="0,1766"/>
            <level id="11" little="0,1363" big="0,1728" prime="0,1766"/>
            <level id="12" little="0,1363" big="0,1478" prime="0,1766"/>
            <level id="13" little="0,1363" big="0,1478" prime="0,1401"/>
            <level id="14" little="0,1075" big="0,1478" prime="0,1401"/>
            <level id="15" little="0,1075" big="0,1152" prime="0,1401"/>
            <level id="16" little="0,1075" big="0,1152" prime="0,1094"/>
            <level id="17" little="0,864"  big="0,1152" prime="0,1094"/>
            <level id="18" little="0,864"  big="0,940"  prime="0,1094"/>
            <level id="19" little="0,864"  big="0,940"  prime="0,806"/>
            <level id="20" little="0,614"  big="0,940"  prime="0,806"/>
            <level id="21" little="0,614"  big="0,652"  prime="0,806"/>
            <level id="22" little="0,614"  big="0,652"  prime="0,806"/>
            <level id="23" little="0,576"  big="0,652"  prime="0,806"/>
            <level id="24" little="0,300"  big="0,652"  prime="0,806"/>
            <level id="25" little="0,300"  big="0,652"  prime="0,806"/>
            <level id="26" little="0,300"  big="0,652"  prime="0,806"/>
            <level id="27" little="0,300"  big="0,652"  prime="0,806"/>
        </cpu_levels>

        <!-- GPU Frequency Ladder -->
        <gpu_levels>
            <level id="1"  min="625" max="625"/>
            <level id="2"  min="625" max="625"/>
            <level id="3"  min="500" max="500"/>
            <level id="4"  min="500" max="500"/>
            <level id="5"  min="500" max="500"/>
            <level id="6"  min="400" max="400"/>
            <level id="7"  min="400" max="400"/>
            <level id="8"  min="400" max="400"/>
            <level id="9"  min="275" max="275"/>
            <level id="10" min="275" max="275"/>
            <level id="11" min="275" max="275"/>
        </gpu_levels>

        <!-- Base Profiles / Scenes -->
        <scenes>
            <scene name="default_scene">
                <level id="5">
                    <action unit="cpu" status="5"/>
                </level>
                <level id="8">
                    <action unit="cpu" status="8"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="10"/>
                    <action unit="dexopt" status="1"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="11"/>
                    <action unit="bg_killer" status="3"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="12"/>
                    <action unit="bg_killer" status="4"/>
                </level>
                <level id="12">
                    <action unit="cpu" status="14"/>
                </level>
                <level id="13">
                    <action unit="cpu" status="16"/>
                </level>
                <level id="14">
                    <action unit="cpu" status="19"/>
                </level>
            </scene>

            <scene name="game">
                <level id="5">
                    <action unit="cpu" status="8"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="10"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="17"/>
                </level>
                <level id="11">
                    <action unit="gpu" status="7"/>
                    <action unit="cpu" status="20"/>
                </level>
                <level id="12">
                    <action unit="gpu" status="10"/>
                </level>
            </scene>

            <scene name="heating_fgs">
                <level id="5">
                    <action unit="cpu" status="20"/>
                </level>
                <level id="7">
                    <action unit="cpu" status="22"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="24"/>
                </level>
            </scene>

            <scene name="axcamera_photo_preview">
                <level id="9">
                    <action unit="cpu" status="13"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="16"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="21"/>
                </level>
            </scene>
        </scenes>

        <!-- Application Specific Thermal & Performance Overrides -->
        <apps>
            <!-- Benchmarks: Allow higher sustained performance before aggressive throttling -->
            <app pkgs="com.antutu.ABenchMark,com.andromeda.androbench2,com.primatelabs.geekbench5,com.primatelabs.geekbench6,net.kishonti.gfxbench.v50000.corporate">
                <level id="5">
                    <action unit="cpu" status="0"/>
                </level>
                <level id="13">
                    <action unit="cpu" status="21"/>
                </level>
                <level id="14">
                    <action unit="cpu" status="24"/>
                </level>
            </app>

            <app pkgs="com.futuremark.dmandroid.application">
                <level id="5">
                    <action unit="cpu" status="0"/>
                </level>
                <level id="12">
                    <action unit="gpu" status="8"/>
                </level>
                <level id="14">
                    <action unit="gpu" status="10"/>
                </level>
            </app>

            <!-- Social / Messaging / Video Calls: Early throttling to prevent chassis heating -->
            <app pkgs="com.instagram.android,com.facebook.katana,com.whatsapp,com.snapchat.android,us.zoom.videomeetings,com.microsoft.teams">
                <level id="4">
                    <action unit="cpu" status="14"/>
                </level>
                <level id="6">
                    <action unit="cpu" status="16"/>
                </level>
                <level id="7">
                    <action unit="cpu" status="19"/>
                </level>
            </app>

            <!-- Navigation: Smoother step-down curve for sustained GPS/Screen sessions -->
            <app pkgs="com.google.android.apps.maps,com.waze">
                <level id="7">
                    <action unit="cpu" status="15"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="21"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="22"/>
                </level>
            </app>

            <!-- Heavy Games (Genshin, PUBG, etc.): Tuned for sustained thermal stability over burst spikes -->
            <app pkgs="com.tencent.tmgp.pubgmhd,com.epicgames.fortnite,com.miHoYo.GenshinImpact,com.miHoYo.hkrpg,com.mojang.minecraftpe,com.HoYoverse.hkrpgoversea,com.miHoYo.Yuanshen,com.pubg.imobile,com.activision.callofduty.shooter,com.dts.freefireth,com.dts.freefiremax">
                <level id="5">
                    <action unit="cpu" status="8"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="10"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="18"/>
                </level>
            </app>
        </apps>
    </atmc>
</perf-config>
