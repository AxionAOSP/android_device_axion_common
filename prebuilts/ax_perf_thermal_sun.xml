<?xml version="1.0" encoding="utf-8"?>
<!--
    SM8735 (Snapdragon 8s Gen 4) thermal / performance ladder, POCO F7 (onyx)

    CPU topology (4 clusters, verified against the device):
      policy0 cpu0-1   364.8 - 2016.0 MHz  -> little
      policy2 cpu2-4   480.0 - 3014.4 MHz  -> mid
      policy5 cpu5-6   480.0 - 2803.2 MHz  -> big
      policy7 cpu7     480.0 - 2956.8 MHz  -> prime
    Level 1 of every column is the usable maximum of that cluster; frequencies are in
    MHz (AxThermalBoostPolicy.toCpuKhz() multiplies values below 10000 by 1000). The
    first number of each pair is the min-frequency floor and is 0 on purpose, like the
    other qcom platform files.

    Known framework gaps on a 4-cluster device, left here so they are not mistaken for
    wrong values in this file:
      - AxPerfConfig.java parses little/big/titanium/prime only, so mid= is ignored, and
        ax_atcm.c keeps ATCM_CLUSTERS at 3 and assigns the floors by policy order, so on
        this SoC policy7 would receive nothing;
      - <gpu_levels> has no consumer yet, it is kept for parity with the other platforms;
      - the app->scene indirection via scene= is not parsed, so <apps> repeats levels.

    gpu_levels mirrors /sys/class/kgsl/kgsl-3d0/devfreq/available_frequencies (Adreno 825).
-->
<perf-config>
    <atmc>
        <cpu_levels>
            <level id="1" little="0,2016" mid="0,3014" big="0,2803" prime="0,2956"/>
            <level id="2" little="0,1980" mid="0,2966" big="0,2758" prime="0,2909"/>
            <level id="3" little="0,1944" mid="0,2918" big="0,2713" prime="0,2862"/>
            <level id="4" little="0,1908" mid="0,2870" big="0,2668" prime="0,2815"/>
            <level id="5" little="0,1872" mid="0,2822" big="0,2623" prime="0,2768"/>
            <level id="6" little="0,1836" mid="0,2774" big="0,2578" prime="0,2721"/>
            <level id="7" little="0,1800" mid="0,2726" big="0,2533" prime="0,2674"/>
            <level id="8" little="0,1764" mid="0,2678" big="0,2488" prime="0,2627"/>
            <level id="9" little="0,1728" mid="0,2630" big="0,2443" prime="0,2580"/>
            <level id="10" little="0,1692" mid="0,2582" big="0,2398" prime="0,2533"/>
            <level id="11" little="0,1656" mid="0,2534" big="0,2353" prime="0,2486"/>
            <level id="12" little="0,1620" mid="0,2486" big="0,2308" prime="0,2439"/>
            <level id="13" little="0,1584" mid="0,2438" big="0,2263" prime="0,2392"/>
            <level id="14" little="0,1548" mid="0,2390" big="0,2218" prime="0,2345"/>
            <level id="15" little="0,1512" mid="0,2342" big="0,2173" prime="0,2298"/>
            <level id="16" little="0,1476" mid="0,2294" big="0,2128" prime="0,2251"/>
            <level id="17" little="0,1440" mid="0,2246" big="0,2083" prime="0,2204"/>
            <level id="18" little="0,1404" mid="0,2198" big="0,2038" prime="0,2157"/>
            <level id="19" little="0,1368" mid="0,2150" big="0,1993" prime="0,2110"/>
            <level id="20" little="0,1332" mid="0,2102" big="0,1948" prime="0,2063"/>
            <level id="21" little="0,1296" mid="0,2054" big="0,1903" prime="0,2016"/>
            <level id="22" little="0,1260" mid="0,2006" big="0,1858" prime="0,1969"/>
            <level id="23" little="0,1224" mid="0,1958" big="0,1813" prime="0,1922"/>
            <level id="24" little="0,1188" mid="0,1910" big="0,1768" prime="0,1875"/>
            <level id="25" little="0,1152" mid="0,1862" big="0,1723" prime="0,1828"/>
            <level id="26" little="0,1116" mid="0,1814" big="0,1678" prime="0,1781"/>
            <level id="27" little="0,1080" mid="0,1766" big="0,1633" prime="0,1734"/>
        </cpu_levels>
        <gpu_levels>
            <level id="1" min="1150" max="1150"/>
            <level id="2" min="1100" max="1100"/>
            <level id="3" min="1050" max="1050"/>
            <level id="4" min="937" max="937"/>
            <level id="5" min="873" max="873"/>
            <level id="6" min="763" max="763"/>
            <level id="7" min="688" max="688"/>
            <level id="8" min="644" max="644"/>
            <level id="9" min="510" max="510"/>
            <level id="10" min="362" max="362"/>
            <level id="11" min="264" max="264"/>
        </gpu_levels>
        <scenes>
            <scene name="default_scene">
                <level id="5">
                    <action unit="cpu" status="5"/>
                </level>
                <level id="8">
                    <action unit="cpu" status="8"/>
                </level>
                <level id="9">
                    <action unit="cpu" status="10"/>
                    <action unit="dexopt" status="1"/>
                </level>
                <level id="10">
                    <action unit="cpu" status="11"/>
                    <action unit="bg_killer" status="3"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="12"/>
                    <action unit="bg_killer" status="4"/>
                </level>
                <level id="12">
                    <action unit="cpu" status="14"/>
                </level>
                <level id="13">
                    <action unit="cpu" status="16"/>
                </level>
                <level id="14">
                    <action unit="cpu" status="19"/>
                </level>
            </scene>

            <!-- Selected automatically while GameManager reports a game: keeps the
                 clocks above default_scene at the same thermal severity. -->
            <scene name="game">
                <level id="4">
                    <action unit="cpu" status="2"/>
                    <action unit="gpu" status="1"/>
                </level>
                <level id="7">
                    <action unit="cpu" status="4"/>
                    <action unit="gpu" status="1"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="8"/>
                    <action unit="gpu" status="2"/>
                </level>
                <level id="14">
                    <action unit="cpu" status="13"/>
                    <action unit="gpu" status="4"/>
                </level>
            </scene>

            <!-- Foreground services that report a heating state. -->
            <scene name="heating_fgs">
                <level id="5">
                    <action unit="cpu" status="7"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="14"/>
                </level>
            </scene>

            <!-- Camera preview: smoothness first, then let default_scene take over. -->
            <scene name="axcamera_photo_preview">
                <level id="5">
                    <action unit="cpu" status="6"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="12"/>
                </level>
            </scene>
        </scenes>
        <apps>
            <!-- Benchmarks: no thermal clamp until the very deep levels. -->
            <app pkgs="com.antutu.ABenchMark,com.andromeda.androbench2,com.primatelabs.geekbench6,net.kishonti.gfxbench.v50000.corporate,com.miui.cit">
                <level id="5">
                    <action unit="cpu" status="0"/>
                </level>
                <level id="13">
                    <action unit="cpu" status="21"/>
                </level>
                <level id="14">
                    <action unit="cpu" status="24"/>
                </level>
            </app>

            <!-- Heavy titles: the game scene is only picked through GameManager, so the
                 well known ones are pinned here too. -->
            <app pkgs="com.miHoYo.GenshinImpact,com.miHoYo.Yuanshen,com.miHoYo.hkrpg,com.HoYoverse.hkrpgoversea,com.tencent.tmgp.pubgmhd,com.pubg.imobile">
                <level id="5">
                    <action unit="cpu" status="2"/>
                </level>
                <level id="11">
                    <action unit="cpu" status="8"/>
                </level>
                <level id="14">
                    <action unit="cpu" status="14"/>
                </level>
            </app>
        </apps>
    </atmc>
</perf-config>
